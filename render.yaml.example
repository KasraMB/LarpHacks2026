# TEMPLATE ONLY. Rename after repository, migrations, auth, and scheduling exist.
services:
  - type: web
    name: alias
    runtime: node
    buildCommand: npm ci && npm run build
    startCommand: npm start
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: alias-db
          property: connectionString
      - key: FEATHERLESS_API_KEY
        sync: false
      - key: FEATHERLESS_MODEL
        sync: false
      - key: CRON_SECRET
        sync: false
  - type: cron
    name: alias-research
    runtime: node
    schedule: "0 6 * * *"
    buildCommand: echo "No build required"
    startCommand: 'curl --fail --request POST --header "Authorization: Bearer $CRON_SECRET" "$APP_URL/api/cron/research"'
    envVars:
      - key: APP_URL
        sync: false
      - key: CRON_SECRET
        sync: false
databases:
  - name: alias-db
