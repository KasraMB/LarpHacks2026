DATABASE_URL=
# Required for accounts. Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Your exact web origin, HTTPS on Render (no path or trailing subdirectory).
BETTER_AUTH_URL=http://localhost:3000
# Optional pair: enables account verification and password-reset email through Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
CRON_SECRET=
APP_URL=http://localhost:3000
# Optional hosted search. Without this key the existing discovery sources still run.
COMPOSIO_API_KEY=
# Optional research limits (at most six articles processed per run).
RESEARCH_MAX_BYTES=1000000
RESEARCH_TIMEOUT_MS=8000
JINA_READER_ENABLED=true
# Optional isolated integration test database; never use the production database.
DATABASE_URL_TEST=

# UI development only: "memory" (writable in-browser fake) or "mock" (static fixtures). Leave empty for the real API.
NEXT_PUBLIC_ALIAS_API=
